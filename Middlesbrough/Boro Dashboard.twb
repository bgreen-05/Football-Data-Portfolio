      <column caption='Quadrant' datatype='string' name='[Calculation_0934337374830610]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if SUM([goals_conceded]) &gt;= WINDOW_AVG(SUM([goals_conceded])) and SUM([xg_faced]) &gt;= WINDOW_AVG(SUM([xg_faced])) then &apos;Conceding High xG and Goals&apos;&#13;&#10;ELSEIF SUM([goals_conceded]) &gt;= WINDOW_AVG(SUM([goals_conceded])) and SUM([xg_faced]) &lt; WINDOW_AVG(SUM([xg_faced])) then &apos;Not Conceding High xG but Conceding Goals&apos;&#13;&#10;ELSEIF SUM([goals_conceded]) &lt; WINDOW_AVG(SUM([goals_conceded])) and SUM([xg_faced]) &lt; WINDOW_AVG(SUM([xg_faced])) then &apos;Not Conceding High xG nor Goals&apos;&#13;&#10;ELSE &apos;Conceding High xG but Not Conceding Goals&apos;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
