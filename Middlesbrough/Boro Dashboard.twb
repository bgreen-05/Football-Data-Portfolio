            </column>
            <column caption='Draws' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0934337354551309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Result] = &apos;D&apos; then 1&#13;&#10;else 0&#13;&#10;end' />
            </column>
            <column caption='Losses' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0934337354579982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Result] = &apos;L&apos; then 1&#13;&#10;else 0&#13;&#10;end' />
            </column>
            <column datatype='string' name='[Formation]' role='dimension' type='nominal' />
            <column datatype='string' name='[Opp Formation]' role='dimension' type='nominal' />
            <column datatype='string' name='[Result]' role='dimension' type='nominal' />
