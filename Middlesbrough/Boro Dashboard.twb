            <column caption='Percentile' datatype='real' name='[Calculation_1061330261852164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ATTR([Stat Name]) = &apos;Fouls Per Match&apos; or ATTR([Stat Name]) = &apos;Yellow cards&apos; or ATTR([Stat Name]) = &apos;Red cards&apos; or ATTR([Stat Name]) = &apos;Big chances missed&apos; or ATTR([Stat Name]) = &apos;Penalties conceded&apos; THEN&#13;&#10;    (SUM([League Rank]) - 1) / 23 * 100&#13;&#10;ELSE&#13;&#10;    (24 - SUM([League Rank])) / 23 * 100&#13;&#10;END' />
            </column>
