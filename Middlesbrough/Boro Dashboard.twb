      <aliases enabled='yes' />
      <column caption='Score' datatype='string' name='[Calculation_0934337345417216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Venue] = &apos;Home&apos; then&#13;&#10;    STR([GF]) + &apos;-&apos; + STR([GA])&#13;&#10;else&#13;&#10;    STR([GA]) + &apos;-&apos; + STR([GF])&#13;&#10;end' />
      </column>
      <column caption='Formation Matchup' datatype='string' name='[Calculation_0934337350254601]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Formation]) + &apos;  vs  &apos; + STR([Opp Formation])' />
      </column>
      <column caption='PPG' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0934337353379851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    if [Result] = &apos;W&apos; then 3&#13;&#10;    ELSEIF [Result] = &apos;D&apos; then 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Wins' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0934337354436620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Result] = &apos;W&apos; then 1&#13;&#10;else 0&#13;&#10;end' />
      </column>
      <column caption='Draws' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0934337354551309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Result] = &apos;D&apos; then 1&#13;&#10;else 0&#13;&#10;end' />
      </column>
      <column caption='Losses' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0934337354579982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Result] = &apos;L&apos; then 1&#13;&#10;else 0&#13;&#10;end' />
      </column>
